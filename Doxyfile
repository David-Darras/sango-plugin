# Doxygen settings of the Sango Plugin API reference.
#
# Usage: type `doxygen` in the project folder.
# Then open doxygen/html/index.html in a web browser.
# Git ignores the folder doxygen/.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "Sango Plugin"
PROJECT_NUMBER         = 6.0.0
PROJECT_BRIEF          = "A C++ library to make ROM hacks of Pokémon Alpha Sapphire"
OUTPUT_DIRECTORY       = doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         docs \
                         lib/include \
                         overlay/include
FILE_PATTERNS          = *.h *.inc *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */private/* */release-* */debug-*
USE_MDFILE_AS_MAINPAGE = README.md
EXAMPLE_PATH           = overlay/src kaizo/src undertow/src
IMAGE_PATH             = assets
INPUT_ENCODING         = UTF-8
EXTENSION_MAPPING      = inc=C++

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
SORT_MEMBER_DOCS       = NO
SHOW_INCLUDE_FILES     = YES

#---------------------------------------------------------------------------
# Preprocessor: build the reference for Alpha Sapphire
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = lib/include
PREDEFINED             = GAME_ORAS \
                         __3DS__ \
                         USE_SANGO_PLUGIN \
                         "INLINE=inline" \
                         "STATIC_INLINE=static inline" \
                         "WEAK=" \
                         "MAKE_SINGLETON(x)=" \
                         "SINGLETON(x)=" \
                         "GAME_ADDRESS(xy,oras)=oras" \
                         "GAME_CONSTANT(xy,oras)=oras"

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO
CLASS_GRAPH            = YES
